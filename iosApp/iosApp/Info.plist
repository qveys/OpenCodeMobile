<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>OpenCode Mobile</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>org.opencodemobile.ios</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <!-- Compose Multiplatform 1.7.1 enforces this key (PlistSanityCheck); the
         app aborts at startup without it. It also lets the UI run at the
         device's full refresh rate. -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSCameraUsageDescription</key>
    <string>Scan a server import QR code to connect to your self-hosted OpenCode Server.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Dictate prompts into the composer. Audio is transcribed on this device only.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Transcribe dictated prompts on this device only. No audio or transcript leaves the device.</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Use Face ID for the optional local access confirmation. It never replaces the server authentication.</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
