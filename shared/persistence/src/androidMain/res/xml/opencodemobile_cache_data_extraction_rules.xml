<?xml version="1.0" encoding="utf-8"?>
<!--
  T3 / OP2 — the cache DB and its -wal/-shm/-journal companions must never enter
  an Android cloud backup or device transfer, independent of the DB's own
  encryption (docs/ARCHITECTURE.md §"Local cache encryption at rest").

  The cache passphrase lives in the Keystore; only its AES/GCM ciphertext is in
  shared preferences, and that blob is excluded too so a device transfer cannot
  carry it (a restored blob is useless without the Keystore key, but excluding it
  avoids a needless key-loss wipe on restore).

  Kept in sync with CACHE_DATABASE_NAME in shared/persistence
  (org.opencodemobile.shared.persistence.cache) and AndroidKeystoreCacheKeyStore.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="opencodemobile_cache.db" />
        <exclude domain="database" path="opencodemobile_cache.db-wal" />
        <exclude domain="database" path="opencodemobile_cache.db-shm" />
        <exclude domain="database" path="opencodemobile_cache.db-journal" />
        <exclude domain="sharedpref" path="opencodemobile_cache_key.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="opencodemobile_cache.db" />
        <exclude domain="database" path="opencodemobile_cache.db-wal" />
        <exclude domain="database" path="opencodemobile_cache.db-shm" />
        <exclude domain="database" path="opencodemobile_cache.db-journal" />
        <exclude domain="sharedpref" path="opencodemobile_cache_key.xml" />
    </device-transfer>
</data-extraction-rules>
